{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/bin/session-start.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|search_replace|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/bin/secrets-guard.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|search_replace",
        "hooks": [
          {
            "type": "command",
            "command": "node .grok/hooks/bin/prettier-edited.js",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
