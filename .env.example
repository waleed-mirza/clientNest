# Public keys may be exposed to the browser. Server-only keys must never be prefixed with NEXT_PUBLIC_.
#
# Preferred: pnpm supabase login && pnpm supabase:setup (writes .env.local).
# Or paste Dashboard → Project Settings → API values:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
#
# Cloud projects may use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY instead of ANON_KEY.
# Never put SUPABASE_SERVICE_ROLE_KEY in client code or commit it.
# Docker / `supabase start` is not required.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — admin scripts, never imported in the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Resend API key for Auth SMTP (`pnpm supabase:smtp`). Not a NEXT_PUBLIC_ value.
# Until a domain is verified, Resend only delivers to the account email.
# Optional in-app notification emails use the same key through a fetch adapter.
# The app works without it. Do not add a Resend SDK.
# RESEND_API_KEY=
# RESEND_FROM=ClientNest <onboarding@resend.dev>

# Hosted public demo only. Blocks writes. Leave unset on buyer installs.
# DEMO_MODE=true
# NEXT_PUBLIC_DEMO_MODE=true

# Absolute URL for “Open the live demo” on the landing page.
# NEXT_PUBLIC_DEMO_URL=https://demo.example.com
